generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  COORDINATOR
  LEADER
  USER
}

enum PostCategory {
  VIDEO
  LIVE
  COMUNICADO
  EVENTO
  GERAL
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  EVENT
  POST
  LIVE
}

enum SupporterStatus {
  PENDING
  VERIFIED
  INVALID
}

enum WhatsappStatus {
  PENDING
  SENT
  CONFIRMED
  FAILED
  OPT_OUT
}

enum CampaignStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CityZone {
  WEST
  NORTH
  SOUTH
  EAST
  OTHER
}

enum WhatsAppConnectionStatus {
  NOT_TESTED
  CONNECTED
  ERROR
}

enum WhatsAppMessageDirection {
  OUTBOUND
  INBOUND
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

model Campaign {
  id                String                  @id @default(cuid())
  name              String
  slug              String                  @unique
  candidateName     String
  party             String?
  logoUrl           String?
  faviconUrl        String?
  primaryColor      String?
  secondaryColor    String?
  accentColor       String?
  backgroundColor   String?
  textColor         String?
  publicTitle       String?
  publicDescription String?
  contactEmail      String?
  contactPhone      String?
  instagramUrl      String?
  facebookUrl       String?
  youtubeUrl        String?
  heroTitle         String?
  heroSubtitle      String?
  heroDescription   String?
  ctaTitle          String?
  ctaDescription    String?
  ctaButtonText     String?
  aboutTitle        String?
  aboutText         String?
  proposalTitle     String?
  proposalItems     Json?
  areasTitle        String?
  areaItems         Json?
  bannerImageUrl    String?
  footerText        String?
  showHero          Boolean                 @default(true)
  showAbout         Boolean                 @default(true)
  showProposals     Boolean                 @default(true)
  showAreas         Boolean                 @default(true)
  showContact       Boolean                 @default(true)
  whatsappNumber    String?
  status            CampaignStatus          @default(ACTIVE)
  users             User[]
  posts             Post[]
  events            Event[]
  lives             Live[]
  notifications     Notification[]
  whatsappConfig    CampaignWhatsAppConfig?
  whatsappMessages  WhatsAppMessage[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status])
  @@index([createdAt])
}

model CampaignWhatsAppConfig {
  id                   String                   @id @default(cuid())
  campaignId           String                   @unique
  campaign             Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phoneNumberId        String                   @unique
  businessAccountId    String
  displayPhoneNumber   String?
  accessTokenEncrypted String
  apiVersion           String                   @default("v25.0")
  enabled              Boolean                  @default(false)
  connectionStatus     WhatsAppConnectionStatus @default(NOT_TESTED)
  lastConnectionAt     DateTime?
  lastConnectionError  String?
  lastTestMessageAt    DateTime?
  lastWebhookAt        DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
}

model WhatsAppMessage {
  id            String                   @id @default(cuid())
  campaignId    String
  campaign      Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  metaMessageId String?                  @unique
  recipient     String
  direction     WhatsAppMessageDirection
  type          String
  status        WhatsAppMessageStatus
  templateName  String?
  errorCode     String?
  errorMessage  String?
  sentByUserId  String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([campaignId, createdAt])
  @@index([campaignId, recipient])
}

model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  password             String
  firstName            String
  lastName             String
  cpf                  String          @unique
  phone                String
  address              String
  city                 String
  state                String
  neighborhood         String?
  zone                 CityZone?
  role                 Role            @default(USER)
  status               SupporterStatus @default(PENDING)
  whatsappStatus       WhatsappStatus  @default(PENDING)
  whatsappLastSent     DateTime?
  whatsappConfirmedAt  DateTime?
  whatsappLastResponse String?
  whatsappError        String?
  lgpdConsent          Boolean         @default(false)
  lgpdConsentAt        DateTime?
  lgpdConsentText      String?
  lgpdConsentVersion   String?
  leaderSlug           String?         @unique
  coordinatorSlug      String?         @unique
  leaderId             String?
  leader               User?           @relation("LeaderSupporters", fields: [leaderId], references: [id], onDelete: SetNull)
  supporters           User[]          @relation("LeaderSupporters")
  coordinatorId        String?
  coordinator          User?           @relation("CoordinatorLeaders", fields: [coordinatorId], references: [id], onDelete: SetNull)
  leaders              User[]          @relation("CoordinatorLeaders")
  campaignId           String?
  campaign             Campaign?       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  posts                Post[]
  events               Event[]
  lives                Live[]
  notifications        Notification[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([leaderId])
  @@index([coordinatorId])
  @@index([campaignId])
  @@index([role])
  @@index([zone])
  @@index([leaderSlug])
  @@index([coordinatorSlug])
  @@index([createdAt])
}

model Post {
  id          String       @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  videoUrl    String?
  category    PostCategory @default(GERAL)
  publishedAt DateTime     @default(now())
  published   Boolean      @default(true)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([published, publishedAt])
  @@index([category])
  @@index([authorId])
  @@index([campaignId])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  date        DateTime
  time        String
  published   Boolean  @default(true)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, date])
  @@index([authorId])
  @@index([campaignId])
}

model Live {
  id           String    @id @default(cuid())
  title        String
  description  String
  thumbnailUrl String?
  youtubeUrl   String
  published    Boolean   @default(true)
  scheduledAt  DateTime?
  authorId     String
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([published, scheduledAt])
  @@index([authorId])
  @@index([campaignId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  message    String
  read       Boolean          @default(false)
  type       NotificationType @default(INFO)
  link       String?
  campaignId String
  campaign   Campaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([campaignId])
}
