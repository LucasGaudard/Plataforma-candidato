# =============================================================================
# Copie este arquivo para .env na RAIZ do monorepo:
#   cp .env.example .env
#
# O apps/web/.env.local pode ser gerado com:
#   cp .env.example apps/web/.env.local
# (use apenas NEXT_PUBLIC_API_URL no .env.local do Next.js)
# =============================================================================

# Banco de dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plataforma_candidato?schema=public"

# API (Fastify)
API_PORT=3333
API_HOST=0.0.0.0
JWT_SECRET="altere-esta-chave-em-producao-com-uma-string-segura-de-pelo-menos-32-caracteres"
FRONTEND_URL="http://localhost:3000"

# Frontend (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:3333"
NEXT_PUBLIC_CAMPAIGN_SLUG="paula-quintanilha"

# Super Admin global (obrigatório em produção para o seed)
SUPER_ADMIN_EMAIL="superadmin@conectaeleitor.local"
SUPER_ADMIN_PASSWORD="Superadmin12345"

# WhatsApp Cloud API (somente API; nunca use NEXT_PUBLIC_ para segredos)
# Gere 32 bytes aleatórios e informe em hexadecimal (64 caracteres) ou base64.
WHATSAPP_CREDENTIALS_ENCRYPTION_KEY=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
API_PUBLIC_URL="http://localhost:3333"
WHATSAPP_DEFAULT_API_VERSION="v25.0"

# Cloudinary (somente API; nunca use NEXT_PUBLIC_ para estas credenciais)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare Turnstile (site key pública servida pela API; secret somente no backend)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ABUSE_LOG_HASH_SECRET=
